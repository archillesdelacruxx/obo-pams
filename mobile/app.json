{
  "expo": {
    "name": "PAMS Mobile",
    "slug": "archillesdc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.obopams.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A1F4D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-image-picker",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-notifications",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PAMS Mobile to use the camera for inspection photos.",
          "microphonePermission": "Allow PAMS Mobile to record audio for inspection notes."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow PAMS Mobile to record audio for inspection notes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PAMS Mobile to use your location for site inspection coordinates.",
          "locationAlwaysAndWhenInUsePermission": "Allow PAMS Mobile to use your location for site inspection coordinates.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PAMS Mobile to access your photos for inspection evidence.",
          "savePhotosPermission": "Allow PAMS Mobile to save inspection photos to your gallery."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "555b7b78-f88f-43d6-97ea-d1301f382207"
      }
    },
    "owner": "archillesdc0106s-team",
    "updates": {
      "url": "https://u.expo.dev/555b7b78-f88f-43d6-97ea-d1301f382207",
      "checkAutomatically": "NEVER"
    }
  }
}
